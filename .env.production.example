# Copy to .env.production (git ignores it) for the one-off production steps run from your
# own machine: the database bootstrap, the first migration and the first admin (RUNBOOK.md,
# "First production setup"). The deployed API never reads this file: Render and GitHub hold
# their own copies. Every value here is a placeholder. Never paste the real ones into chat,
# code or tickets, and never reuse staging's passwords or keys.
#
# Passwords: long, letters and digits only, so they need no escaping inside a URL.
# The production Supabase project (Ireland, eu-west-1), Supavisor session pooler (port
# 5432), always verify-full. <project-ref> is the project's id (its URL, Project Settings);
# <pooler-host> is the host Supabase → Connect → Session pooler shows, for example
# aws-0-eu-west-1.pooler.supabase.com.

APP_ENV=production

# The commands here run without Sentry or OTLP; production's settings would refuse them
# otherwise. Only this file: Render's production service has both and never sets this.
OBSERVABILITY_REQUIRED=false

# The project's `postgres` role (Supabase → Connect → Session pooler, its database password).
# Only for the bootstrap; delete this line from your copy afterwards.
BOOTSTRAP_ADMIN_DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?ssl=verify-full

# The two Gize roles; you choose their passwords, and the bootstrap sets them.
# DATABASE_URL also goes into Render; MIGRATOR_DATABASE_URL into GitHub (the production
# environment's secrets).
DATABASE_URL=postgresql://gize_app.<project-ref>:<gize-app-password>@<pooler-host>:5432/postgres?ssl=verify-full
MIGRATOR_DATABASE_URL=postgresql://gize_migrator.<project-ref>:<gize-migrator-password>@<pooler-host>:5432/postgres?ssl=verify-full

# Supabase's public root CA, committed with the code (the image carries it too).
DATABASE_SSL_ROOT_CERT=docker/certs/supabase-root-2021-ca.crt

# Supabase Auth, for the first-admin command. The secret key: Project Settings → API Keys →
# Secret keys (`sb_secret_...`); create one there if there is none.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Required by the settings, unused by these commands: your local Redis is fine.
REDIS_URL=redis://127.0.0.1:6379/0
