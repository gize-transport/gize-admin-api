{
  "components": {
    "schemas": {
      "AuditEntryPage": {
        "description": "A page of the audit log (a named schema: generated clients keep the name).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEntryRead"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "AuditEntryPage",
        "type": "object"
      },
      "AuditEntryRead": {
        "additionalProperties": false,
        "description": "One recorded change. `before`/`after` hold only the fields that changed; personal\nones read \"[redacted]\". `actor_staff_id` is null for operator commands.",
        "properties": {
          "action": {
            "maxLength": 64,
            "title": "Action",
            "type": "string"
          },
          "actor_staff_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Staff Id"
          },
          "after": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "After"
          },
          "before": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Before"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "entity_id": {
            "format": "uuid",
            "title": "Entity Id",
            "type": "string"
          },
          "entity_type": {
            "maxLength": 50,
            "title": "Entity Type",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "id",
          "created_at",
          "actor_staff_id",
          "action",
          "entity_type",
          "entity_id",
          "before",
          "after",
          "request_id"
        ],
        "title": "AuditEntryRead",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable error codes: never rename or reuse one; only add.",
        "enum": [
          "BAD_REQUEST",
          "CORS_PREFLIGHT_REJECTED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "PAYLOAD_TOO_LARGE",
          "VALIDATION_FAILED",
          "INVALID_CURSOR",
          "IDEMPOTENCY_KEY_REQUIRED",
          "IDEMPOTENCY_KEY_MISMATCH",
          "IDEMPOTENCY_IN_PROGRESS",
          "RATE_LIMITED",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "location": {
            "enum": [
              "body",
              "query",
              "path",
              "header",
              "cookie"
            ],
            "title": "Location",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/ValidationReason"
          }
        },
        "required": [
          "location",
          "field",
          "reason"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "StaffMe": {
        "additionalProperties": false,
        "description": "The signed-in staff member.",
        "properties": {
          "email": {
            "maxLength": 320,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 200,
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          }
        },
        "required": [
          "id",
          "full_name",
          "email",
          "role"
        ],
        "title": "StaffMe",
        "type": "object"
      },
      "StaffRole": {
        "enum": [
          "admin",
          "staff"
        ],
        "title": "StaffRole",
        "type": "string"
      },
      "ValidationProblem": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "errors_truncated": {
            "title": "Errors Truncated",
            "type": "boolean"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "request_id",
          "errors",
          "errors_truncated"
        ],
        "title": "ValidationProblem",
        "type": "object"
      },
      "ValidationReason": {
        "description": "Why a field failed validation: our vocabulary, not the validation library's.",
        "enum": [
          "missing",
          "unknown_field",
          "too_long",
          "too_short",
          "out_of_range",
          "invalid_type",
          "invalid_format",
          "not_allowed",
          "invalid_json",
          "invalid"
        ],
        "title": "ValidationReason",
        "type": "string"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "A Supabase access token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Gize Admin API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/audit-log": {
      "get": {
        "description": "Every recorded change, filtered by entity or actor. Names, emails and other personal\nvalues never appear: the entries show only that they changed.",
        "operationId": "audit_log_list",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "entity_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 50,
                  "pattern": "^[a-z][a-z_]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Type"
            }
          },
          {
            "in": "query",
            "name": "entity_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Id"
            }
          },
          {
            "in": "query",
            "name": "actor_staff_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Actor Staff Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEntryPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthenticated",
            "x-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden",
            "x-error-codes": [
              "FORBIDDEN"
            ]
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ValidationProblem"
                    },
                    {
                      "$ref": "#/components/schemas/Problem"
                    }
                  ]
                }
              }
            },
            "description": "Invalid Cursor, Validation Failed",
            "x-error-codes": [
              "INVALID_CURSOR",
              "VALIDATION_FAILED"
            ]
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests",
            "x-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error",
            "x-error-codes": [
              "INTERNAL_ERROR"
            ]
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable",
            "x-error-codes": [
              "SERVICE_UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "The audit log, newest first",
        "tags": [
          "audit log"
        ]
      }
    },
    "/v1/staff/me": {
      "get": {
        "description": "Your ID, name, email and role. The admin portal calls it after sign-in.",
        "operationId": "staff_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMe"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthenticated",
            "x-error-codes": [
              "UNAUTHENTICATED"
            ]
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden",
            "x-error-codes": [
              "FORBIDDEN"
            ]
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests",
            "x-error-codes": [
              "RATE_LIMITED"
            ]
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error",
            "x-error-codes": [
              "INTERNAL_ERROR"
            ]
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable",
            "x-error-codes": [
              "SERVICE_UNAVAILABLE"
            ]
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "The signed-in staff member",
        "tags": [
          "staff"
        ]
      }
    }
  }
}
