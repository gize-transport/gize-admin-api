# Copy to .env.staging (git ignores it) for the one-off staging steps run from your own
# machine: the database bootstrap and the first admin (RUNBOOK.md, "First staging setup").
# The deployed API never reads this file: Render and GitHub hold their own copies.
# Every value here is a placeholder. Never paste the real ones into chat, code or tickets.
#
# Passwords: long, letters and digits only, so they need no escaping inside a URL.
# Project pahktmbnbyulqkhdruci, Supavisor session pooler (port 5432), always verify-full.
# The pooler host is the project's own (Supabase → Connect → Session pooler); its
# certificate was checked against docker/certs/ with verify-full on 2026-11-02.

APP_ENV=staging

# The project's `postgres` role (Supabase → Connect → Session pooler, its database password).
# Only for the bootstrap; delete this line from your copy afterwards.
BOOTSTRAP_ADMIN_DATABASE_URL=postgresql://postgres.pahktmbnbyulqkhdruci:<database-password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?ssl=verify-full

# The two Gize roles; you choose their passwords, and the bootstrap sets them.
# DATABASE_URL also goes into Render; MIGRATOR_DATABASE_URL into GitHub (Actions secrets).
DATABASE_URL=postgresql://gize_app.pahktmbnbyulqkhdruci:<gize-app-password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?ssl=verify-full
MIGRATOR_DATABASE_URL=postgresql://gize_migrator.pahktmbnbyulqkhdruci:<gize-migrator-password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?ssl=verify-full

# Supabase's public root CA, committed with the code (the image carries it too).
DATABASE_SSL_ROOT_CERT=docker/certs/supabase-root-2021-ca.crt

# Supabase Auth, for the first-admin command.
SUPABASE_URL=https://pahktmbnbyulqkhdruci.supabase.co
SUPABASE_SECRET_KEY=

# Required by the settings, unused by these commands: your local Redis is fine.
REDIS_URL=redis://127.0.0.1:6379/0
