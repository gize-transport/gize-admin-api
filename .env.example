# Copy to .env for local development. Every value here is a non-secret placeholder.
# Real secrets are set in the host's secret store, never committed.

# --- API (read by src/gize_api/core/config.py) ---------------------------------------
# local | test | staging | production. Interactive docs are served in local and staging only.
APP_ENV=local
# redis:// or rediss:// URL. Secret in staging/production (may hold a password).
REDIS_URL=redis://127.0.0.1:6379/0
# Comma-separated browser origins allowed by CORS, e.g. the admin portal. https outside
# local/test. Empty means no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Header a trusted proxy writes the client's IP into (CF-Connecting-IP behind Cloudflare).
# Empty: the connection's address. Never set it without such a proxy in front.
CLIENT_IP_HEADER=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (Postgres; Supabase in staging/production) --------------------------------
# The app connects as gize_app (data only); migrations as gize_migrator (schema owner).
# Staging and production: ?ssl=verify-full (with DATABASE_SSL_ROOT_CERT). Direct or session-mode
# pooler (port 5432), never transaction mode (6543). Secrets.
DATABASE_URL=postgresql://gize_app:change-me-app@127.0.0.1:5432/gize
MIGRATOR_DATABASE_URL=postgresql://gize_migrator:change-me-migrator@127.0.0.1:5432/gize
# CA certificate (PEM file path) for ssl=verify-full; Supabase's comes from the project's
# database settings. Empty: the system CAs.
DATABASE_SSL_ROOT_CERT=
# Connections per process (pool + overflow); keep the sum over all processes under the
# pooler's client limit.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Only for the one-off bootstrap (python -m gize_api.core.bootstrap), never for the app.
BOOTSTRAP_ADMIN_DATABASE_URL=postgresql://postgres:change-me-local-only@127.0.0.1:5432/gize

# --- Observability (required in production; staging logs a warning when unset) --------
# Sentry project DSN (https). Secret.
SENTRY_DSN=
# OTLP/HTTP base URL for traces and metrics (Grafana Cloud), e.g. https://otlp-gateway-<zone>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated name=value headers for the OTLP exporter (Grafana Cloud auth). Secret.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=gize-admin-api
# Share of new traces recorded, 0..1 (default 1). Trace context sent by clients is ignored.
OTEL_TRACES_SAMPLER_RATIO=1.0
# Production refuses to start without SENTRY_DSN and OTEL_EXPORTER_OTLP_ENDPOINT unless false.
OBSERVABILITY_REQUIRED=true
# Build identifier shown in Sentry and traces, e.g. the git SHA. [A-Za-z0-9._-], max 64.
RELEASE=

# --- Tests only (tests/conftest.py) ------------------------------------------------------
# The Redis that tests talk to (db 15 of the compose Redis). Never a shared or real one.
TEST_REDIS_URL=redis://127.0.0.1:6379/15
# A superuser on the compose *test* server (postgres-test, port 5433), never the development
# one: tests set the gize_app/gize_migrator passwords to test values and create and drop
# their own gize_test_* databases.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:gize-test-only@127.0.0.1:5433/postgres

# --- Local Docker services (docker-compose.yml) ---------------------------------------
# Dev-only password for the loopback-only container; never reuse it anywhere else.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
REDIS_PORT=6379
